---
import '@fontsource-variable/inter';
import '../styles/global.css';
interface Props { title?: string; description?: string }
const { title = 'Лотос — дом для жизни | Tan House', description = 'Посмотрите дом Лотос от Tan House: прогулка по комнатам, планировка и терраса. Визуальная презентация проекта.' } = Astro.props;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f3ec" />
    <link rel="icon" href="/lotos-icon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/media/13_front.webp" />
    <meta property="og:image:alt" content="Дом Лотос — фасад в окружении сада" />
    <meta property="og:image:width" content="1600" />
    <meta property="og:image:height" content="900" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body><a class="skip-link" href="#main">К содержанию</a><slot /></body>
</html>

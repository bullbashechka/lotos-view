{
  "name": "tan-house-lotos",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "packageManager": "bun@1.3.14",
  "type": "module",
  "workspaces": [
    "website"
  ],
  "overrides": {
    "@babel/core": "^7.29.7",
    "@hono/node-server": "^2.1.0",
    "brace-expansion": "^5.0.9",
    "browserslist": "^4.28.9",
    "esbuild": "^0.28.1",
    "fast-uri": "^3.1.7",
    "hono": "^4.12.34",
    "ip-address": "^10.5.0",
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.26",
    "qs": "^6.16.0",
    "sharp": "^0.35.3",
    "undici": "^7.29.0",
    "yaml": "^2.9.0"
  },
  "scripts": {
    "dev": "bun run dev:lotos",
    "dev:website": "bun run --cwd website dev",
    "dev:lotos": "bun run --cwd website dev --host 127.0.0.1",
    "build": "bun run build:website",
    "build:website": "bun run --cwd website build",
    "preview": "bun run preview:lotos",
    "preview:lotos": "bun run --cwd website preview --host 127.0.0.1 --port 4325",
    "typecheck": "bun run typecheck:website",
    "typecheck:website": "bun run --cwd website typecheck",
    "test": "bun run test:website",
    "test:website": "bun run --cwd website test",
    "test:lotos": "bun run test:website",
    "test:build-contracts": "bun run build:website && bun run --cwd website test:build-contracts",
    "check": "bun run typecheck && bun run test && bun run test:build-contracts"
  }
}
